# ============================================================
# DELIVERY DELAY & OPERATIONS ANALYTICS
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns


# ============================================================
# STEP 1: LOAD DATA
# ============================================================

df = pd.read_csv("delivery_operations.csv")

print("=" * 70)
print("DELIVERY DELAY & OPERATIONS ANALYTICS")
print("=" * 70)

print("\nDataset Shape:")
print(df.shape)

print("\nFirst 5 Records:")
print(df.head())


# ============================================================
# STEP 2: DATA INFORMATION
# ============================================================

print("\n" + "=" * 70)
print("DATA INFORMATION")
print("=" * 70)

print(df.info())

print("\nColumns:")
print(df.columns.tolist())

print("\nStatistical Summary:")
print(df.describe(include="all"))


# ============================================================
# STEP 3: CHECK MISSING VALUES
# ============================================================

print("\n" + "=" * 70)
print("MISSING VALUES")
print("=" * 70)

print(df.isnull().sum())


# ============================================================
# STEP 4: CHECK DUPLICATES
# ============================================================

print("\n" + "=" * 70)
print("DUPLICATES")
print("=" * 70)

print(
    "Duplicate rows:",
    df.duplicated().sum()
)

print(
    "Duplicate order IDs:",
    df["order_id"].duplicated().sum()
)


# ============================================================
# STEP 5: REMOVE DUPLICATES
# ============================================================

df = df.drop_duplicates(
    subset="order_id"
)

print(
    "\nRecords after duplicate removal:",
    len(df)
)


# ============================================================
# STEP 6: CONVERT DATE COLUMNS
# ============================================================

df["order_date"] = pd.to_datetime(
    df["order_date"],
    errors="coerce"
)

df["promised_date"] = pd.to_datetime(
    df["promised_date"],
    errors="coerce"
)

df["actual_delivery_date"] = pd.to_datetime(
    df["actual_delivery_date"],
    errors="coerce"
)


print("\nDate conversion completed.")


# ============================================================
# STEP 7: HANDLE MISSING VALUES
# ============================================================

numeric_columns = [
    "warehouse_processing_hours",
    "distance_km",
    "delivery_attempts"
]

for column in numeric_columns:

    df[column] = df[column].fillna(
        df[column].median()
    )


categorical_columns = [
    "warehouse",
    "carrier",
    "route",
    "product_type",
    "day_of_week",
    "season"
]

for column in categorical_columns:

    df[column] = df[column].fillna(
        "Unknown"
    )


# ============================================================
# STEP 8: CALCULATE DELIVERY DELAY
# ============================================================

df["delay_days"] = (
    df["actual_delivery_date"]
    -
    df["promised_date"]
).dt.days


# ============================================================
# STEP 9: ON-TIME FLAG
# ============================================================

df["on_time_flag"] = np.where(
    df["delay_days"] <= 0,
    1,
    0
)


# ============================================================
# STEP 10: DELIVERY STATUS
# ============================================================

df["delivery_status"] = np.where(
    df["delay_days"] <= 0,
    "On Time",
    "Delayed"
)


print("\nDelivery Status:")
print(
    df["delivery_status"]
    .value_counts()
)


# ============================================================
# STEP 11: DELAY CATEGORY
# ============================================================

def delay_category(days):

    if days <= 0:
        return "On Time"

    elif days <= 2:
        return "1-2 Days Late"

    elif days <= 5:
        return "3-5 Days Late"

    else:
        return "6+ Days Late"


df["delay_category"] = (
    df["delay_days"]
    .apply(delay_category)
)


print("\nDelay Categories:")
print(
    df["delay_category"]
    .value_counts()
)


# ============================================================
# STEP 12: MAIN KPIs
# ============================================================

total_orders = df[
    "order_id"
].nunique()

delayed_orders = (
    df["delay_days"] > 0
).sum()

on_time_orders = (
    df["delay_days"] <= 0
).sum()

on_time_percentage = (
    on_time_orders /
    total_orders
) * 100

delay_percentage = (
    delayed_orders /
    total_orders
) * 100

average_delay = (
    df["delay_days"].mean()
)

median_delay = (
    df["delay_days"].median()
)

maximum_delay = (
    df["delay_days"].max()
)


print("\n" + "=" * 70)
print("DELIVERY KPIs")
print("=" * 70)

print(
    "Total Orders:",
    total_orders
)

print(
    "On-Time Orders:",
    on_time_orders
)

print(
    "Delayed Orders:",
    delayed_orders
)

print(
    "On-Time Percentage:",
