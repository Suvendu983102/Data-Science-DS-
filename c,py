# ============================================================
# STEP 27: SIMPLE DELAY RISK MODEL
# ============================================================

# Simple rule-based risk score
df["delay_risk_score"] = 0

df.loc[
    df["distance_km"] > 1000,
    "delay_risk_score"
] += 1

df.loc[
    df["warehouse_processing_hours"] > 12,
    "delay_risk_score"
] += 1

df.loc[
    df["delivery_attempts"] > 1,
    "delay_risk_score"
] += 1

df.loc[
    df["season"] == "Festive",
    "delay_risk_score"
] += 1


def risk_category(score):

    if score == 0:
        return "Low"

    elif score <= 2:
        return "Medium"

    else:
        return "High"


df["delay_risk"] = (
    df["delay_risk_score"]
    .apply(risk_category)
)


