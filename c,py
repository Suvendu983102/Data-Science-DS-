)


# ============================================================
# STEP 13: MONTHLY DELIVERY TREND
# ============================================================

df["month"] = (
    df["order_date"]
    .dt.to_period("M")
    .astype(str)
)


monthly_delivery = (
    df.groupby("month")
    .agg(
        total_orders=("order_id", "count"),
        delayed_orders=("delay_days",
                        lambda x: (x > 0).sum()),
        average_delay=("delay_days", "mean"),
        on_time_rate=("on_time_flag", "mean")
    )
    .reset_index()
)


monthly_delivery[
    "on_time_rate"
] = (
    monthly_delivery["on_time_rate"]
    * 100
)


print("\n" + "=" * 70)
print("MONTHLY DELIVERY PERFORMANCE")
print("=" * 70)

